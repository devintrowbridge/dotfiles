# git
alias glo="git log --oneline --decorate"               # git log oneline
alias gdt="git diff HEAD^ HEAD"                        # git diff tip
alias gsu="git submodule init && git submodule update" # git sub & up
alias gcm="git commit -m"                              # git commit message
alias gs="git status"

# shell command shorthands
function cdls { cd "$@" && ls; }

# run last command as sudo
alias please='sudo $(history -p !!)'
alias ll="ls -ag"

# docker remove dangling
function drd {
  docker images | grep "<none>" | awk '{print $3}' | xargs docker rmi
}

# docker exec bash
function deb {
  docker exec -it "$1" /bin/bash
}

# docker run bash
function drb {
  docker run -it --rm "$@" /bin/bash
}

function mp4togif {
  ffmpeg -i "$1" -vf "fps=10,scale=1280:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" -loop 0 output.gif && cp output.gif .
}

# grow partition
# 1. grow the partition
# sudo growpart /dev/sda 2 # separate partition number from the device
# 2. grow the filesystem
# sudo resize2fs /dev/sda2
